   :touches ["kafun_edn" "remediate" "autorun/kotoba" "ie_flow" "digest"]}
  {:id "season-envelope" :name "シーズンnowcast包絡"
   :uses ["f-hanako" "f-pollen-annual" "f-tokyo-navi"]
   :intake "repo外season prior EDN {region-class week-bucket rate-min/max source as-of} をbeat時注入"
   :touches ["dynamics" "react_loop" "autorun" "digest"]}
  {:id "nursery-supply" :name "苗木・再造林需給readiness校正"
   :uses ["f-naegi" "f-youran" "f-hakusyo"]
   :intake "repo外集計→envelope EDN {supply-rate-min/max consent-rate-min/max source fiscal-year}"
   :touches ["dynamics" "react_loop" "ie_flow" "digest"]}
  {:id "constraint-layer" :name "保護・同意・炭素制約レイヤ"
   :uses ["f-genkyou" "f-youran" "f-hakusyo"]
   :intake "repo外script: 公開割合→代表stand EDN (bool/enum+丸め規則ID+典拠)。地域クラス以上"
